# Copy to .env and fill in. Never commit .env.

# Anthropic (required unless fixture demo mode)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Google OAuth (required unless demo mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
OAUTHLIB_INSECURE_TRANSPORT=1

# Database
# Host port for the Postgres container; change only if 5432 is taken (then update both URLs below).
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/docintel
DATABASE_READONLY_URL=postgresql+psycopg://app_readonly:app_readonly@localhost:5432/docintel

# Local secrets (generate with scripts/gen_keys.py)
FERNET_KEY=
SESSION_SECRET=

# Tuning (optional)
SYNC_INTERVAL_SECONDS=30
WORKER_CONCURRENCY=4
MAX_ATTEMPTS=3
REVIEW_CONFIDENCE_THRESHOLD=0.7
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ASK_MAX_STEPS=6
DEMO_MODE=
